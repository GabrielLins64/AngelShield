{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "AngelShield",
  "version": "0.1.2",
  "description": "Gerenciador local de credenciais com criptografia simétrica e preenchimento assistido.",
  "permissions": ["storage", "clipboardWrite", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir AngelShield",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "commands": {
    "open-autofill-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Abrir a caixa de autopreenchimento do AngelShield"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js", "src/content/credential-save-prompt.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/as_logo-removebg.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
